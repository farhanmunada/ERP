# --- Application ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Database (MySQL 8.0.16+) ---
DATABASE_URL=mysql://erp:erppass@127.0.0.1:3306/erp
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=erppass
MYSQL_PORT=3306

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://erp:erppass@127.0.0.1:5672
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erppass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
